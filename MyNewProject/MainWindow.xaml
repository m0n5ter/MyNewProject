<Window x:Class="MyNewProject.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:MyNewProject.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance viewModels:MainViewModel}"
        Title="{Binding Title}" Height="560" Width="640">

    <!--
        The entire navigation of the application.

        Content is DATA - a view model - and WPF finds the view for it by the runtime
        type in Views/ViewTemplates.xaml. There is no Visibility, no converter and no
        DataContext="{Binding Something}" here any more, and only one screen exists
        in the visual tree at a time.

        The DataContext of the window is handed over by whoever created it: App.OnStartup.
        The <Window.DataContext><viewModels:MainViewModel/> of lesson 7 is gone - XAML can
        only call a parameterless constructor, and MainViewModel asks for its dependencies.
    -->
    <ContentControl Content="{Binding CurrentViewModel}" Margin="20"/>
</Window>
